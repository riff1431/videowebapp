{
  "name": "next-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "seed": "node --env-file=.env node_modules/tsx/dist/cli.mjs src/db/seed/seed.ts",
    "db:reset": "node --env-file=.env node_modules/tsx/dist/cli.mjs scripts/reset-db.ts",
    "setup": "node --env-file=.env node_modules/tsx/dist/cli.mjs scripts/setup.ts",
    "cron": "node --env-file=.env node_modules/tsx/dist/cli.mjs scripts/cron.ts",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "test:seed": "node --env-file=.env.test node_modules/tsx/dist/cli.mjs tests/setup/seed.ts",
    "test:cleanup": "node --env-file=.env.test node_modules/tsx/dist/cli.mjs tests/setup/cleanup.ts",
    "test:api": "vitest run tests/api",
    "test:rls": "vitest run tests/rls",
    "test:static": "vitest run tests/static",
    "test:e2e": "playwright test",
    "test": "vitest run tests/api tests/rls tests/static && playwright test"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@supabase/supabase-js": "^2.117.2",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/sanitize-html": "^2.16.2",
    "better-auth": "^1.7.5",
    "clsx": "^2.1.1",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.45.3",
    "lucide-react": "^1.47.0",
    "next": "16.3.6",
    "nodemailer": "^10.0.10",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.88.0",
    "recharts": "^3.10.1",
    "sanitize-html": "^2.18.0",
    "tailwind-merge": "^3.7.0",
    "tsx": "^4.23.15",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.5",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
